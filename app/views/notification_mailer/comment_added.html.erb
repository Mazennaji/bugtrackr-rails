<!DOCTYPE html>
<html>
  <head>
    <style>
      body { font-family: Arial, sans-serif; color: #333; }
      .container { max-width: 600px; margin: 0 auto; padding: 20px; }
      .header { background: #1a1a2e; color: white; padding: 20px; border-radius: 8px 8px 0 0; }
      .body { background: #f9f9f9; padding: 20px; border-radius: 0 0 8px 8px; }
      .comment-box { background: white; border-left: 4px solid #4CAF50; padding: 15px; margin: 15px 0; border-radius: 0 8px 8px 0; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h2>BugTrackr</h2>
        <p>New comment on your issue</p>
      </div>
      <div class="body">
        <p>Hi <strong><%= @user.name %></strong>,</p>
        <p>A new comment was added to <strong><%= @issue.title %></strong>:</p>

        <div class="comment-box">
          <p><strong><%= @comment.user.name %></strong> said:</p>
          <p><%= @comment.body %></p>
        </div>

        <p>Project: <strong><%= @project.name %></strong></p>

        <p style="margin-top: 20px; color: #999; font-size: 12px;">
          You are receiving this email because you are assigned to this issue on BugTrackr.
        </p>
      </div>
    </div>
  </body>
</html>